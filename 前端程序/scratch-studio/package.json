{
  "name": "scratch-studio",
  "version": "0.1.0",
  "private": true,
  "description": "西瓜创客 Scratch 工作台（学生端），基于 @scratch/scratch-gui 受控集成",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "webpack serve --mode development",
    "dev": "webpack serve --mode development",
