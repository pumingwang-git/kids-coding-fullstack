    "test:security": "node scripts/verify-security-overrides.cjs"
  },
  "dependencies": {
    "@scratch/scratch-gui": "15.1.0",
    "hull.js": "file:vendor/hull.js",
    "immutable": "4.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
    "html-webpack-plugin": "^5.6.0",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "overrides": {
    "hull.js": "$hull.js",
    "immutable": "$immutable"
  }
