ENVIRONMENT=development
# Copy this file to .env and replace the placeholder locally. Never commit a real password.
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/study_auth
# 生产环境必须替换所有示例密钥，并配置 PostgreSQL、Redis 与 SMTP。
JWT_SECRET_KEY=mNlmwhUn4C2Q-pSnZbz_6nBUcRgU-wdeL73cfXOfWMG5I3Pwfz86aITGy2XsQzmy
JWT_PREVIOUS_SECRET_KEY=
REFRESH_TOKEN_HMAC_KEY=replace-with-a-separate-random-secret
REFRESH_TOKEN_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
VERIFICATION_HMAC_KEY=tCjIvogPXXM6daC4K2pIGpdFj9L549zaNzEFzRnCCMLwf5NoEIZ5g_9QJzpecoP9
OUTBOX_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173
# Set this only when traffic reaches Uvicorn through a trusted reverse proxy.
TRUSTED_PROXY_IPS=
# Optional: the local GeoLite2-City.mmdb file. The application never accepts
# a geo location supplied by the browser.
GEOIP_DATABASE_PATH=
# Preferred China-focused offline lookup. Download xdb files from ip2region;
# configure v4 at minimum, and v6 if your reverse proxy accepts IPv6 clients.
IP2REGION_V4_DATABASE_PATH=
IP2REGION_V6_DATABASE_PATH=
LOGIN_LOCATION_TTL_DAYS=90
COOKIE_SECURE=false
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_BASE_SECONDS=30
LOGIN_LOCK_MAX_SECONDS=900
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_SECONDS=300
OUTBOX_RETRY_BASE_SECONDS=60
MFA_ENABLED=false
CAPTCHA_ENABLED=true
# ============ HIBP 泄露密码检查（k-anonymity）与密码历史 ============
# 服务端只发送 SHA-1 摘要的前 5 位给 api.pwnedpasswords.com，剩余后缀在本地比对，
# 完整密码和完整摘要都不会离开本服务。
PWNED_CHECK_ENABLED=true
# 开发环境可设为 false；生产环境必须为 true，否则服务会拒绝启动。
# true=泄露库不可用时拒绝注册/改密（fail-closed）。
PWNED_CHECK_STRICT=false
# 国内网络不稳定时可指向自建镜像/代理，保持相同的 /range/{prefix} 接口。
PWNED_API_BASE_URL=https://api.pwnedpasswords.com
PWNED_TIMEOUT_SECONDS=3.0
# 每个用户保留的最近密码数量；新密码不得与当前密码或这些历史密码相同。
PASSWORD_HISTORY_COUNT=5
#===================== 邮箱验证 ====================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-qq-email@qq.com
SMTP_PASSWORD=your-qq-smtp-authorization-code
SMTP_FROM=your-qq-email@qq.com
# ======================= IP地址登录地区解析 =========================
IP2REGION_V4_DATABASE_PATH=data/ip2region_v4.xdb
IP2REGION_V6_DATABASE_PATH=
GEOIP_DATABASE_PATH=

# ===================== Judge 后端配置 =========================
JUDGE_BACKEND=go-judge
JUDGE_URL=http://127.0.0.1:5050
# 用 `openssl rand -hex 24` 在服务器上生成，只写进 .env。本文件受 git 跟踪，永远留空。
JUDGE_TOKEN=

# ===================== MinIO / S3 对象存储（视频模块） =========================
# API 端口（默认 9000）。本地 SSH 隧道连腾讯云时填 http://127.0.0.1:9000；
# 生产填内网域名，并设 MINIO_USE_SSL=true。应用用专用账号 app_uploader（readwrite），不用 root。
MINIO_ENDPOINT=http://127.0.0.1:9000
# 用 `openssl rand -hex 24` 在服务器生成，只写进 .env，本文件永远留空。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_SOURCE_BUCKET=videos-source
MINIO_PLAY_BUCKET=videos-play
# 播放令牌签名密钥，与 MINIO_SECRET_KEY 分开；用 `openssl rand -hex 24` 生成。
MINIO_PLAY_SECRET=change-me-video-play-secret
# 播放令牌有效期（分钟）。
VIDEO_TOKEN_MINUTES=60
# 源文件上限（字节）。2GiB。
VIDEO_SOURCE_MAX_BYTES=2147483648
# 建议分片大小（字节）。64MiB。
VIDEO_PART_SIZE=67108864

# ===================== MinIO / S3 对象存储（资料模块） =========================
# 资料桶与视频桶隔离（生命周期/清理互不干扰）。需在 MinIO 创建该桶（Private）
# 并授权 app_uploader readwrite。迁移 0031 的表结构与代码默认值都是 materials，
# 这里显式声明避免环境不一致。
MINIO_MATERIALS_BUCKET=materials
# 单资料文件上限（字节）。1GiB。
MATERIAL_SOURCE_MAX_BYTES=1073741824
# 大文件建议分片大小（字节）。16MiB。
MATERIAL_PART_SIZE=16777216
# 单个迁移会话清单总字节上限（字节）。20GiB。
MATERIAL_IMPORT_SESSION_MAX_BYTES=21474836480


# ===================== 转码（Celery + ffmpeg） =========================
# ffmpeg/ffprobe 目录（本地开发用 data/ffmpeg/bin 的静态构建；生产服务器 apt 装的在 /usr/bin）
# FFMPEG_BIN_DIR=data/ffmpeg/bin
# 转码临时工作目录（下载源 + 本地 HLS 产物，转完即清）
# TRANSCODE_WORK_ROOT=data/transcode
# Celery broker：本地不配则 eager 同步执行（不依赖 Redis）；生产配 redis://user:pass@host:6379/0
# REDIS_URL===redis://127.0.0.1:6380/0
